<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Một bầu trời lời chúc · Khánh Linh</title>
<style>
:root{--ink:#254e70;--muted:#617e94;--blue:#377da8;--sky:#eaf6ff;--line:#d5e7f2;--white:#fffefa;--font:ui-rounded,"SF Pro Rounded","Segoe UI",Tahoma,Arial,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;color:var(--ink);font-family:var(--font);background:#f8fbfe;font-size:15px;line-height:1.65}
button,input,textarea,select{font:inherit}
button,a,input,textarea,select{-webkit-tap-highlight-color:transparent}
button{cursor:pointer}
button:disabled{opacity:.55;cursor:wait}
button,a{touch-action:manipulation}
a{color:inherit;text-decoration:none}
button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #69a8ce;outline-offset:4px}
button{color:inherit}
.wrap{width:min(1100px,calc(100% - 48px));margin:auto}
.preview-note{background:#e2eff8;color:#47667e;text-align:center;font-size:12px;padding:9px 20px}
.preview-note strong{font-weight:750}
header{background:#f8fbfe;border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:86px}
.brand{display:flex;gap:11px;align-items:center;font-size:18px;font-weight:800;letter-spacing:-.6px}
.brandmark{display:grid;place-items:center;width:39px;height:39px;border:1px solid #bdd9ec;border-radius:14px;background:#e5f3fe;font-size:23px}
.navright{display:flex;gap:27px;align-items:center;font-size:13px;font-weight:650}
.btn{border:1px solid transparent;border-radius:99px;padding:12px 23px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;line-height:1.4;transition:transform .18s,background .18s}
.btn:hover{transform:translateY(-2px)}
.primary{background:var(--blue);color:white;box-shadow:0 5px 0 #266185}
.primary:hover{background:#2d709b}
.secondary{border-color:#b9d7e9;background:white}
.small{padding:10px 19px}
.hero{position:relative;background:radial-gradient(ellipse at 76% 30%,#d9eeff 0,transparent 54%),#eff8ff;overflow:hidden;border-bottom:1px solid var(--line)}
.hero:after{content:"";position:absolute;bottom:-26px;left:-2%;width:104%;height:42px;background:#f8fbfe;border-radius:50% 50% 0 0}
.hero-inner{display:grid;grid-template-columns:1.2fr 1fr;gap:42px;align-items:center;padding:69px 0 74px}
.eyebrow{display:inline-flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800;background:#fff9;border:1px solid #c9e2f4;padding:7px 13px;border-radius:99px}
h1{font-size:clamp(38px,4.8vw,61px);line-height:1.23;letter-spacing:-2px;font-weight:850;margin:22px 0 18px}
h1 span{color:#3982b4}
.hero-copy>p{font-size:15px;max-width:430px;color:var(--muted);line-height:1.9;margin-bottom:25px}
.hero-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.text-link{font-size:13px;font-weight:700;border-bottom:1px solid #99bdd5;padding:6px 0}
.handnote{font-size:12px;color:#7c95a9;margin-top:20px;letter-spacing:.2px}
.scrapbook{position:relative;min-height:365px;display:flex;align-items:center;justify-content:center}
.polaroid{position:relative;transform:rotate(5deg);width:307px;background:var(--white);padding:15px 15px 23px;box-shadow:0 15px 45px #38668e20,0 2px 5px #38668e12;border:1px solid #e0e8ed;text-align:center;z-index:2}
.tape{position:absolute;top:-13px;left:98px;transform:rotate(-7deg);width:108px;height:30px;background:#a8cce4a8;border-left:2px dashed #e7f5ff;border-right:2px dashed #e7f5ff}
.art{display:block;width:100%;background:#d9edfc;border-radius:2px}
.polaroid p{font-size:17px;font-weight:750;letter-spacing:-.4px;margin:13px 0 0}
.polaroid small{font-size:10px;color:#7890a3;letter-spacing:2px;text-transform:uppercase}
.sticker{position:absolute;z-index:3;right:2px;bottom:45px;background:#fff8df;color:#88723b;border:1px solid #eaddb4;padding:12px 17px;border-radius:45% 52% 43% 50%;transform:rotate(-12deg);font-size:12px;font-weight:750;box-shadow:0 4px 0 #879eb515}
.sparkle{position:absolute;color:#76acd0;font-size:40px;left:12px;top:43px;transform:rotate(-13deg)}
.sparkle.two{font-size:26px;right:1px;left:auto;top:48px}
.doodle{position:absolute;bottom:28px;left:4px;transform:rotate(-12deg);font-size:13px;color:#6c92ad}
.intro{display:flex;align-items:center;gap:16px;padding:28px 0;border-bottom:1px dashed #ccdeeb}
.intro-icon{flex:none;display:grid;place-items:center;background:#e9f4fc;border:1px solid #d4e7f4;border-radius:50%;width:42px;height:42px;font-size:18px}
.intro p{margin:0;font-size:13px;color:var(--muted)}
.intro strong{color:var(--ink);font-weight:700}
main{padding:41px 0 70px;min-height:400px}
.section-top{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:25px}
.kicker{font-size:10px;font-weight:750;letter-spacing:2.2px;text-transform:uppercase;color:#7e9ab1;margin-bottom:6px}
h2{font-size:29px;letter-spacing:-1px;margin:0;line-height:1.4}
.count{vertical-align:middle;display:inline-grid;place-items:center;min-width:29px;height:29px;padding:0 7px;margin-left:6px;background:#e4f1fb;border-radius:50%;font-size:12px;letter-spacing:0}
.section-top p{margin:6px 0 0;font-size:13px;color:var(--muted)}
.toolbar{display:flex;align-items:center;gap:14px;justify-content:space-between;margin-bottom:26px;flex-wrap:wrap}
.tabs{display:flex;gap:7px}
.tab{background:transparent;border:1px solid var(--line);border-radius:99px;padding:7px 15px;font-size:12px;font-weight:650}
.tab[aria-pressed=true]{color:#fff;background:var(--ink);border-color:var(--ink)}
.filters{display:flex;gap:10px}
.search{width:200px;border:1px solid var(--line);border-radius:99px;background:white;padding:8px 15px;font-size:12px;color:var(--ink)}
select{border:1px solid var(--line);border-radius:99px;background:white;padding:7px 11px;font-size:12px;color:var(--ink);max-width:160px}
.wall{columns:3;column-gap:20px}
.card{break-inside:avoid;display:inline-block;width:100%;margin-bottom:22px;background:#fff;border:1px solid #dbe8f1;border-radius:15px;box-shadow:0 5px 15px #3d658407;padding:23px;text-align:left}
.card:nth-child(3n+2){background:#edf6fe}
.card:nth-child(3n+3){background:#fffdf5}
.card-top{display:flex;align-items:center;gap:10px}
.avatar{display:grid;place-items:center;flex:none;width:37px;height:37px;border-radius:50%;background:#dbeefa;color:#487b9d;font-size:16px;font-weight:750}
.author{font-size:13px;font-weight:750;overflow-wrap:anywhere;line-height:1.5}
.date{font-size:10px;color:#7991a3}
.card-sticker{margin-left:auto;align-self:start;font-size:21px}
.wish-text{font-size:14px;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere;margin:18px 0 0}
.photo-btn{display:block;border:0;background:transparent;padding:0;margin-top:17px;width:100%;border-radius:8px;overflow:hidden}
.photo-btn img{display:block;width:100%;max-height:360px;object-fit:cover}
.card-foot{font-size:10px;color:#8398a8;border-top:1px dashed #cfdfeb;margin-top:20px;padding-top:12px;letter-spacing:.3px}
.empty{padding:36px 25px 41px;border:1px dashed #bcd6e8;background:linear-gradient(130deg,#fff,#edf7ff);border-radius:19px;text-align:center}
.empty svg{width:106px;height:85px;margin-bottom:8px}
.empty h3{font-size:20px;margin:4px 0 8px;letter-spacing:-.5px}
.empty p{font-size:13px;color:var(--muted);margin:0 auto 22px;max-width:390px}
footer{text-align:center;border-top:1px solid var(--line);padding:29px 20px 32px;color:#7892a6;font-size:11px}
footer .footer-name{font-size:14px;font-weight:750;color:#527a98;margin-bottom:5px}
footer .heart{color:#7daed0}
dialog{border:1px solid #d6e7f2;border-radius:24px;padding:0;width:min(510px,calc(100% - 28px));max-height:calc(100dvh - 32px);color:var(--ink);background:#fcfeff;box-shadow:0 25px 90px #143d6c40;overflow:auto}
dialog::backdrop{background:#173b5a69;backdrop-filter:blur(5px)}
.modal-head{position:relative;padding:27px 29px 19px;background:#edf7ff;border-bottom:1px solid var(--line)}
.modal-head h2{font-size:25px}
.modal-head p{font-size:12px;color:var(--muted);margin:8px 25px 0 0}
.close{border:1px solid #ccdfed;background:#fff9;border-radius:50%;width:32px;height:32px;position:absolute;right:17px;top:17px;font-size:21px;line-height:1;display:grid;place-items:center}
form{padding:23px 29px 28px}
.field{margin-bottom:19px}
label,.field-title{display:block;font-size:12px;font-weight:750;margin-bottom:7px}
.optional{font-weight:400;color:#7f94a4}
input[type=text],textarea{width:100%;border:1px solid #ccdfea;border-radius:11px;background:white;padding:11px 13px;color:var(--ink);outline-offset:2px}
input::placeholder,textarea::placeholder{color:#8da1b0;font-size:12px}
textarea{resize:vertical;min-height:128px;font-size:14px;line-height:1.7}
.counter{text-align:right;color:#8398a9;font-size:10px}
.moods{display:flex;gap:8px}
.mood{background:white;border:1px solid var(--line);border-radius:11px;width:43px;height:39px;font-size:20px}
.mood[aria-pressed=true]{background:#e4f2ff;border:2px solid #73a8cb}
.upload{position:relative;display:block;background:#f0f7fc;border:1px dashed #accce2;border-radius:11px;padding:15px;text-align:center;cursor:pointer}
.upload:focus-within{outline:3px solid #69a8ce;outline-offset:3px}
.upload input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.upload span{display:block;font-size:12px;font-weight:700}
.upload small{display:block;font-size:10px;color:#7c92a3;margin-top:2px}
.attachment{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:10px;padding:9px;margin-top:10px}
.attachment img{width:55px;height:55px;object-fit:cover;border-radius:6px}
.attachment span{font-size:11px;flex:1;overflow-wrap:anywhere}
.remove{border:0;background:#edf4f9;border-radius:8px;font-size:12px;padding:5px 10px}
.form-note{font-size:10px;color:#7a91a3;margin:17px 0 0;text-align:center}
.submit{width:100%;margin-top:3px}
.error{font-size:12px;color:#a33e44;background:#fff0f0;border-radius:8px;padding:8px 11px;margin-bottom:13px}
[hidden]{display:none!important}
.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);padding:13px 23px;border-radius:16px;background:#254e70;color:white;box-shadow:0 8px 25px #1b3c6a30;z-index:20;font-size:13px;max-width:calc(100% - 32px);width:max-content}
#photoDialog{width:min(860px,calc(100% - 28px));background:#f7fbfe;padding:48px 16px 16px}
#largePhoto{display:block;max-width:100%;max-height:76dvh;object-fit:contain;margin:auto;border-radius:9px}
#photoCaption{text-align:center;font-size:12px;margin:12px 0 0}
@media(min-width:900px){.card:hover{box-shadow:0 9px 25px #38668e10}}
@media(max-width:800px){.hero-inner{gap:15px}.polaroid{width:250px}.scrapbook{min-height:320px}.tape{left:75px}.sticker{right:-5px;bottom:25px}.wall{columns:2}.navright{gap:15px}.doodle{left:0;bottom:0}}
@media(max-width:600px){
.wrap{width:calc(100% - 34px)}.nav{min-height:73px}.brand{font-size:15px;gap:8px}.brandmark{width:32px;height:32px;font-size:20px}
.navright>a{display:none}.navright .btn{font-size:11px;padding:10px 13px}
.hero-inner{grid-template-columns:1fr;padding:38px 0 49px;gap:9px}
.hero-copy{text-align:center}.eyebrow{font-size:9px;letter-spacing:1.7px}
h1{font-size:41px;letter-spacing:-1.4px;margin-top:20px}.hero-copy>p{margin:0 auto 23px;font-size:14px;max-width:340px}.hero-actions{justify-content:center;gap:17px}
.handnote{margin-top:18px}.scrapbook{min-height:304px;max-width:330px;width:100%;margin:11px auto 0}.polaroid{width:241px}
.sticker{right:-2px;bottom:29px}.doodle{left:0;bottom:12px;font-size:11px}.sparkle{top:45px;left:0}.sparkle.two{top:29px}
.intro{align-items:flex-start;padding:24px 0}.intro p{font-size:12px}
main{padding:31px 0 43px}.section-top{align-items:center}h2{font-size:25px}.section-top>.btn{display:none}
.toolbar{gap:14px}.filters{width:100%}.search{flex:1;min-width:0}.wall{columns:1}.card{padding:22px}
.modal-head{padding:25px 22px 18px}form{padding:20px 22px 25px}.empty{padding:28px 19px 33px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>
<div class="preview-note"><strong>Bản xem thử</strong> · <span id="storageNote">Lời chúc và ảnh chỉ lưu trong trình duyệt này, chưa chia sẻ giữa các thiết bị.</span></div>
<header>
  <nav class="wrap nav" aria-label="Điều hướng chính">
    <a class="brand" href="#" aria-label="Trang đầu lưu bút Khánh Linh"><span class="brandmark" aria-hidden="true">☁</span> Linh’s little sky</a>
    <div class="navright">
      <a href="#loi-chuc">Những lời thương</a>
      <button class="btn secondary small" data-compose>Viết cho Linh <span aria-hidden="true">↗</span></button>
    </div>
  </nav>
</header>

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <div class="eyebrow"><span aria-hidden="true">✦</span> Lưu bút tốt nghiệp thạc sĩ</div>
      <h1>Một chặng đường.<br>Một bầu trời<br><span>yêu thương.</span></h1>
      <p>Dành tặng <strong>Phan Nguyễn Khánh Linh</strong>.<br>Một lời chúc, một kỷ niệm, một chiếc ảnh xinh —<br>để ngày đặc biệt này ở lại thật lâu.</p>
      <div class="hero-actions">
        <button class="btn primary" data-compose>Gửi một lời thương <span aria-hidden="true">♡</span></button>
        <a class="text-link" href="#loi-chuc">Đọc những lời chúc ↓</a>
      </div>
      <div class="handnote">Một góc nhỏ, cất giữ những điều thật lớn.</div>
    </div>
    <div class="scrapbook" aria-label="Minh họa mũ tốt nghiệp giữa những đám mây">
      <span class="sparkle" aria-hidden="true">✧</span>
      <span class="sparkle two" aria-hidden="true">✦</span>
      <div class="polaroid">
        <div class="tape" aria-hidden="true"></div>
        <svg class="art" viewBox="0 0 280 235" role="img" aria-label="Mũ tốt nghiệp xanh, bằng tốt nghiệp và mây trắng">
          <defs><linearGradient id="sky" x2="0" y2="1"><stop stop-color="#c4e4fa"/><stop offset="1" stop-color="#eaf6ff"/></linearGradient></defs>
          <rect width="280" height="235" fill="url(#sky)"/>
          <circle cx="229" cy="43" r="19" fill="#fff5c9"/>
          <g fill="#fff" opacity=".85">
            <path d="M-12 68c0-13 17-20 27-12 2-22 36-25 43-3 21-6 31 23 8 25H-8z"/>
            <path d="M219 102c-5-15 14-28 25-17 10-23 39-16 39 5 21-3 25 22 4 25h-60z"/>
            <path d="M-17 204c-2-21 25-27 38-13 2-28 44-33 55-5 18-16 47-3 44 20 19-5 26 21 6 29H-17z"/>
            <path d="M171 217c-2-18 22-26 32-11-1-30 39-41 53-15 23-13 44 9 33 30l-1 14H170z"/>
          </g>
          <g fill="#77aed2"><path d="m59 102 3 8 8 3-8 3-3 8-3-8-8-3 8-3z"/><path d="m207 148 3 7 7 3-7 3-3 7-3-7-7-3 7-3z"/></g>
          <g transform="rotate(-10 140 110)">
            <path d="M94 93v35c22 20 65 20 87-1V93" fill="#6199c0" stroke="#427ca5" stroke-width="2"/>
            <path d="m62 82 77-35 78 35-78 38z" fill="#3c729a" stroke="#315f81" stroke-width="2" stroke-linejoin="round"/>
            <path d="m139 81 59 15v43" fill="none" stroke="#f4d58b" stroke-width="3" stroke-linecap="round"/>
            <circle cx="139" cy="81" r="4" fill="#edcf85"/>
            <path d="m198 136-5 19h11z" fill="#f4d58b"/>
          </g>
          <g transform="rotate(13 139 174)">
            <rect x="96" y="159" width="86" height="30" rx="7" fill="#fffdf2" stroke="#bdcfd9" stroke-width="1.5"/>
            <ellipse cx="98" cy="174" rx="6" ry="15" fill="#f0eee1" stroke="#bdcfd9" stroke-width="1.5"/>
            <rect x="137" y="158" width="10" height="32" rx="2" fill="#8bb3d3"/>
            <path d="m142 173-11 9 5-15 6 6 9-8 2 15z" fill="#5b8fb8"/>
          </g>
          <g stroke="#fff" stroke-width="2.3" stroke-linecap="round"><path d="m86 35 3 8M185 30l-3 7M36 151l7-2M230 173l5 5"/></g>
        </svg>
        <p>Khánh Linh, you did it!</p>
        <small>A little page. A lot of love.</small>
      </div>
      <div class="sticker" aria-hidden="true">Hooray!<br>Thạc sĩ rồi ♡</div>
      <div class="doodle" aria-hidden="true">những điều đẹp nhất<br>vẫn còn ở phía trước ↗</div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="intro">
    <div class="intro-icon" aria-hidden="true">♡</div>
    <p><strong>Có những lời, mình muốn giữ mãi.</strong><br>Ghé qua đây, để lại đôi dòng cho Linh nhé. Dài hay ngắn cũng được, chỉ cần là từ bạn.</p>
  </div>
  <main id="loi-chuc">
    <div class="section-top">
      <div>
        <div class="kicker">The little guestbook</div>
        <h2>Những lời thương <span class="count" id="count">0</span></h2>
        <p>Từng lời chúc là một mảnh ghép của ngày vui.</p>
      </div>
      <button class="btn secondary small" data-compose>＋ Thêm lời chúc</button>
    </div>
    <div class="toolbar">
      <div class="tabs" role="group" aria-label="Lọc lời chúc">
        <button class="tab" data-filter="all" aria-pressed="true">Tất cả</button>
        <button class="tab" data-filter="photo" aria-pressed="false">Có ảnh kỷ niệm</button>
      </div>
      <div class="filters">
        <input id="search" class="search" type="search" aria-label="Tìm lời chúc hoặc tên người gửi" placeholder="Tìm một lời thương…">
        <select id="sort" aria-label="Sắp xếp lời chúc"><option value="new">Mới nhất trước</option><option value="old">Cũ nhất trước</option></select>
      </div>
    </div>
    <div id="wall" class="wall" aria-label="Danh sách lời chúc"></div>
    <div id="empty" class="empty">
      <svg viewBox="0 0 120 90" aria-hidden="true">
        <g transform="rotate(-7 60 48)">
          <rect x="19" y="25" width="82" height="53" rx="7" fill="#fff" stroke="#9ebfd7" stroke-width="1.8"/>
          <path d="m21 27 39 29 39-29" fill="#e5f2fc" stroke="#9ebfd7" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="m22 75 25-24m51 24L73 51" fill="none" stroke="#c4dbeb" stroke-width="1.5"/>
          <path d="M60 51c-19-11-8-23 0-13 8-10 19 2 0 13" fill="#7baed0"/>
        </g>
        <path d="m100 9 2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="#d8bb73"/>
        <circle cx="16" cy="18" r="3" fill="#aecfe6"/>
      </svg>
      <h3 id="emptyTitle">Lời thương đầu tiên đang chờ bạn</h3>
      <p id="emptyText">Hãy mở đầu cuốn lưu bút này bằng một lời chúc dành cho tân thạc sĩ Khánh Linh nhé!</p>
      <button class="btn primary small" data-compose>Viết lời chúc đầu tiên ♡</button>
    </div>
  </main>
</div>

<footer>
  <div class="footer-name">Phan Nguyễn Khánh Linh <span class="heart">♡</span></div>
  Một dấu mốc đáng nhớ. Những người bạn đáng thương yêu.<br>
  <span style="display:inline-block;margin-top:10px;font-size:10px">Lưu bút tốt nghiệp thạc sĩ · Made of little moments & lots of love</span>
</footer>

<dialog id="composeDialog" aria-labelledby="composeTitle">
  <div class="modal-head">
    <div class="kicker">A little note for Linh</div>
    <h2 id="composeTitle">Gửi một lời thương ♡</h2>
    <p>Một lời chúc ấm áp hay một kỷ niệm vui — Linh sẽ rất vui khi được đọc.</p>
    <button class="close" type="button" id="closeCompose" aria-label="Đóng form">×</button>
  </div>
  <form id="wishForm">
    <div class="field">
      <label for="sender">Bạn là ai nhỉ? <span class="optional">(không bắt buộc)</span></label>
      <input type="text" id="sender" maxlength="60" autocomplete="name" placeholder="Tên hoặc biệt danh của bạn…" autofocus>
    </div>
    <div class="field">
      <label for="message">Đôi dòng dành cho Linh <span aria-hidden="true">♡</span></label>
      <textarea id="message" maxlength="2000" required placeholder="Linh ơi, chúc mừng cậu tốt nghiệp thạc sĩ…"></textarea>
      <div class="counter"><span id="charCount">0</span> / 2.000</div>
    </div>
    <div class="field">
      <div class="field-title" id="stickerLabel">Đính kèm một chút dễ thương</div>
      <div class="moods" role="group" aria-labelledby="stickerLabel">
        <button type="button" class="mood" data-mood="💙" aria-label="Trái tim xanh" aria-pressed="true">💙</button>
        <button type="button" class="mood" data-mood="🎓" aria-label="Mũ tốt nghiệp" aria-pressed="false">🎓</button>
        <button type="button" class="mood" data-mood="🌷" aria-label="Hoa tulip" aria-pressed="false">🌷</button>
        <button type="button" class="mood" data-mood="✨" aria-label="Lấp lánh" aria-pressed="false">✨</button>
        <button type="button" class="mood" data-mood="☁️" aria-label="Mây trắng" aria-pressed="false">☁️</button>
      </div>
    </div>
    <div class="field">
      <div class="field-title">Một chiếc ảnh kỷ niệm <span class="optional">(tùy bạn)</span></div>
      <label class="upload">
        <input type="file" id="photo" accept="image/jpeg,image/png,image/webp" aria-label="Chọn ảnh kỷ niệm">
        <span>＋ Chọn ảnh của chúng mình</span>
        <small>JPG, PNG hoặc WebP · Tối đa 8 MB · 1 ảnh</small>
      </label>
      <div id="attachment" class="attachment" hidden>
        <img id="thumb" alt="Ảnh bạn đã chọn">
        <span id="fileName"></span>
        <button class="remove" id="removePhoto" type="button">Bỏ ảnh</button>
      </div>
    </div>
    <div id="formError" class="error" role="alert" hidden></div>
    <button class="btn primary submit" id="submitWish" type="submit">Thêm vào lưu bút thử ♡</button>
    <p class="form-note">Bản xem thử: chưa gửi cho Linh. Dữ liệu chỉ ở trình duyệt này;<br>xóa dữ liệu trình duyệt sẽ làm mất lời chúc đã lưu.</p>
  </form>
</dialog>

<dialog id="photoDialog" aria-label="Xem ảnh kỷ niệm">
  <button class="close" type="button" id="closePhoto" aria-label="Đóng ảnh">×</button>
  <img id="largePhoto" alt="">
  <p id="photoCaption"></p>
</dialog>
<div id="toast" class="toast" role="status" hidden></div>

<script>
(() => {
  "use strict";
  const $ = id => document.getElementById(id);
  const KEY = "khanh-linh-graduation-guestbook-v1";
  const moodOptions = ["💙","🎓","🌷","✨","☁️"];
  let wishes = [], persistent = true, filter = "all", mood = "💙";
  let selectedPhoto = "", photoVersion = 0, photoBusy = false, toastTimer;
  const safeImage = s => typeof s === "string" && /^data:image\/(?:jpeg|png|webp);base64,[A-Za-z0-9+/=]+$/.test(s);
  try {
    const stored = JSON.parse(localStorage.getItem(KEY) || "[]");
    if (Array.isArray(stored)) {
      wishes = stored.filter(w => w && typeof w.text === "string" &&
        typeof w.name === "string" && Number.isFinite(w.time))
        .map(w => ({name:w.name.slice(0,60),text:w.text.slice(0,2000),
          time:w.time,photo:safeImage(w.photo)?w.photo:"",
          mood:moodOptions.includes(w.mood)?w.mood:"💙"}));
    }
    const probe = KEY + "-check";
    localStorage.setItem(probe,"1");
    localStorage.removeItem(probe);
  } catch {
    persistent = false;
    $("storageNote").textContent = "Trình duyệt không cho phép lưu: lời chúc thử chỉ còn trong phiên mở trang này. Chưa chia sẻ giữa các thiết bị.";
  }

  function toast(text) {
    clearTimeout(toastTimer);
    $("toast").textContent = text;
    $("toast").hidden = false;
    toastTimer = setTimeout(() => $("toast").hidden = true, 5500);
  }
  function error(text) {
    $("formError").textContent = text;
    $("formError").hidden = !text;
  }
  function node(tag, className, text) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  }
  function normalize(s) {
    return s.normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/đ/g,"d").replace(/Đ/g,"D").toLowerCase();
  }
  function render() {
    const wall = $("wall");
    wall.replaceChildren();
    $("count").textContent = wishes.length;
    const query = normalize($("search").value.trim());
    const list = wishes.filter(w => (filter !== "photo" || w.photo) &&
      normalize(w.name+" "+w.text).includes(query))
      .sort((a,b) => $("sort").value === "old" ? a.time-b.time : b.time-a.time);

    for (const w of list) {
      const card = node("article","card");
      const top = node("div","card-top");
      const avatar = node("div","avatar",Array.from(w.name.trim())[0]?.toLocaleUpperCase("vi") || "♡");
      avatar.setAttribute("aria-hidden","true");
      const info = node("div");
      info.append(node("div","author",w.name));
      const date = node("time","date",new Date(w.time).toLocaleDateString("vi-VN",{day:"2-digit",month:"2-digit",year:"numeric"}));
      date.dateTime = new Date(w.time).toISOString();
      info.append(date);
      const sticker = node("span","card-sticker",w.mood);
      sticker.setAttribute("aria-hidden","true");
      top.append(avatar,info,sticker);
      card.append(top,node("p","wish-text",w.text));
      if (w.photo) {
        const button = node("button","photo-btn");
        button.type = "button";
        button.setAttribute("aria-label","Xem ảnh kỷ niệm của "+w.name);
        const img = node("img");
        img.src = w.photo;
        img.alt = "Ảnh kỷ niệm do "+w.name+" đính kèm";
        img.loading = "lazy";
        button.append(img);
        button.addEventListener("click",() => {
          $("largePhoto").src = w.photo;
          $("largePhoto").alt = img.alt;
          $("photoCaption").textContent = "Một kỷ niệm từ "+w.name+" ♡";
          $("photoDialog").showModal();
        });
        card.append(button);
      }
      card.append(node("div","card-foot","Gửi Khánh Linh, với thật nhiều yêu thương ♡"));
      wall.append(card);
    }
    $("empty").hidden = list.length > 0;
    if (!list.length) {
      const untouched = wishes.length === 0 && !query && filter === "all";
      $("emptyTitle").textContent = untouched ? "Lời thương đầu tiên đang chờ bạn" : "Chưa tìm thấy lời chúc phù hợp";
      $("emptyText").textContent = untouched ?
        "Hãy mở đầu cuốn lưu bút này bằng một lời chúc dành cho tân thạc sĩ Khánh Linh nhé!" :
        "Bạn thử đổi từ khóa, chọn “Tất cả”, hoặc thêm một kỷ niệm mới nhé.";
      $("empty").querySelector("button").textContent = untouched ? "Viết lời chúc đầu tiên ♡" : "Viết một lời chúc ♡";
    }
  }
  document.querySelectorAll("[data-compose]").forEach(b => b.addEventListener("click",() => {
    error("");
    $("composeDialog").showModal();
  }));
  $("closeCompose").addEventListener("click",() => $("composeDialog").close());
  $("closePhoto").addEventListener("click",() => $("photoDialog").close());
  document.querySelectorAll("[data-filter]").forEach(b => b.addEventListener("click",() => {
    filter = b.dataset.filter;
    document.querySelectorAll("[data-filter]").forEach(x => x.setAttribute("aria-pressed",String(x === b)));
    render();
  }));
  document.querySelectorAll("[data-mood]").forEach(b => b.addEventListener("click",() => {
    mood = b.dataset.mood;
    document.querySelectorAll("[data-mood]").forEach(x => x.setAttribute("aria-pressed",String(x === b)));
  }));
  $("search").addEventListener("input",render);
  $("sort").addEventListener("change",render);
  $("message").addEventListener("input",() => {
    $("message").setCustomValidity("");
    $("charCount").textContent = $("message").value.length;
  });

  function removePhoto() {
    photoVersion++;
    selectedPhoto = "";
    photoBusy = false;
    $("photo").value = "";
    $("attachment").hidden = true;
    $("thumb").removeAttribute("src");
    $("submitWish").disabled = false;
  }
  $("removePhoto").addEventListener("click",removePhoto);
  $("photo").addEventListener("change",async () => {
    const file = $("photo").files[0];
    if (!file) return;
    removePhoto();
    error("");
    if (!["image/jpeg","image/png","image/webp"].includes(file.type)) {
      error("Bạn chọn ảnh JPG, PNG hoặc WebP nhé."); return;
    }
    if (file.size > 8*1024*1024) {
      error("Ảnh hơi lớn rồi. Bạn chọn ảnh nhỏ hơn 8 MB nhé."); return;
    }
    const version = ++photoVersion;
    photoBusy = true;
    $("submitWish").disabled = true;
    const url = URL.createObjectURL(file);
    try {
      const img = new Image();
      await new Promise((resolve,reject) => {
        img.onload = resolve;
        img.onerror = reject;
        img.src = url;
      });
      if (version !== photoVersion) return;
      const scale = Math.min(1,1100/Math.max(img.naturalWidth,img.naturalHeight));
      const canvas = document.createElement("canvas");
      canvas.width = Math.max(1,Math.round(img.naturalWidth*scale));
      canvas.height = Math.max(1,Math.round(img.naturalHeight*scale));
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0,0,canvas.width,canvas.height);
      ctx.drawImage(img,0,0,canvas.width,canvas.height);
      selectedPhoto = canvas.toDataURL("image/jpeg",.78);
      $("thumb").src = selectedPhoto;
      $("fileName").textContent = file.name;
      $("attachment").hidden = false;
    } catch {
      if (version === photoVersion) error("Mình chưa đọc được ảnh này. Bạn thử chọn ảnh khác nhé.");
    } finally {
      URL.revokeObjectURL(url);
      if (version === photoVersion) {
        photoBusy = false;
        $("submitWish").disabled = false;
      }
    }
  });

  $("wishForm").addEventListener("submit",event => {
    event.preventDefault();
    if (photoBusy) return;
    error("");
    const text = $("message").value.trim();
    if (!text) {
      $("message").setCustomValidity("Bạn viết vài dòng cho Linh trước nhé.");
      $("message").reportValidity();
      return;
    }
    const entry = {
      name:$("sender").value.trim() || "Một người bạn",
      text, mood, photo:selectedPhoto, time:Date.now()
    };
    const updated = [...wishes,entry];
    if (persistent) {
      try { localStorage.setItem(KEY,JSON.stringify(updated)); }
      catch {
        error("Bộ nhớ trình duyệt đã đầy hoặc không thể lưu. Lời chúc vẫn ở trong form; bạn thử bỏ ảnh rồi gửi lại nhé.");
        return;
      }
    }
    wishes = updated;
    $("wishForm").reset();
    $("charCount").textContent = "0";
    removePhoto();
    mood = "💙";
    document.querySelectorAll("[data-mood]").forEach(x => x.setAttribute("aria-pressed",String(x.dataset.mood === mood)));
    $("search").value = "";
    $("sort").value = "new";
    filter = "all";
    document.querySelectorAll("[data-filter]").forEach(x => x.setAttribute("aria-pressed",String(x.dataset.filter === filter)));
    render();
    $("composeDialog").close();
    $("loi-chuc").scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});
    toast(persistent ? "Đã lưu lời chúc thử trong trình duyệt này ♡" : "Đã thêm lời chúc thử. Lời chúc sẽ mất khi đóng hoặc tải lại trang.");
  });
  render();
})();
</script>
</body>
</html>
